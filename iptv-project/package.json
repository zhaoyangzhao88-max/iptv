{
  "name": "owl-iptv-player",
  "version": "1.0.0",
  "description": "智能电视盒风格精品 IPTV 播放客户端",
  "author": "Zhao Yang",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node --test --experimental-default-type=module tests/*.test.js"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1"
  },
  "build": {
    "appId": "com.owl.iptv.player",
    "productName": "OwlIPTV",
    "win": {
      "target": [
        "portable"
      ]
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "data/channels.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "compression": "maximum",
    "extraResources": [
      {
        "from": "../iptv-engine-b/node_api",
        "to": "node_api",
        "filter": [
          "**/*",
          "!tests/**"
        ]
      }
    ]
  },
  "dependencies": {
    "hls.js": "1.6.16"
  }
}
